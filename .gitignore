# ============================================================
# Robomuffin Idea Factory — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/

# ---------- Environment variables (contains API keys!) ----------
.env
.env.*
!.env.example

# ---------- Secrets / credentials (v1.276.4) ----------
# The worker-helper token used to be hard-coded as a default in seven tracked
# files. It now resolves from RBMN_HELPER_TOKEN, this sidecar, or the forge
# settings store — see scripts/helper_token.py. NEVER commit the sidecar.
scripts/helper_token.txt
**/helper_token.txt
*.pem
*.key
*.pfx
*.p12
id_rsa*
credentials.json
service-account*.json
secrets.json
*_secret*
*_token.txt

# ---------- Database ----------
*.db
*.db-wal
*.db-shm

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ---------- Frontend ----------
frontend/dist/
frontend/node_modules/
frontend/package-lock.json
frontend/vite.config.ts.timestamp-*

# ---------- Logs ----------
logs/
*.log

# ---------- Temporary / backup files ----------
*.tmp
*.temp
*.bak

# ---------- Project data (generated at runtime, machine-specific) ----------
audio_clips/
cache/
generated/
stems/

# ---------- Sample videos (too large for GitHub, hosted externally) ----------
Videos/

# ---------- Local ComfyUI workflow files (reference only, not part of app) ----------
LTX-2.3-Workflows/

# ---------- Dev notes (personal reference, not for public repo) ----------
devnotes/

# ---------- Dev artifacts (not needed for public repo) ----------
Devscreenshots/
transition_comparison.png
V2V_NESTEDTENSOR_FIX.md
vrgamedevgirl84/

# ---------- Blueprint / original spec docs ----------
Blueprint/
Original Ideas.txt
RBMF - Storyboard Blueprint.md
RBMF - Storyboard Blueprint.pdf
CLAUDE.md

# ---------- Website / marketing assets (personal, not for public repo) ----------
website-product-page.html
website-*.html

# ---------- Alembic (unused — migrations are inline in database.py) ----------
alembic.ini
alembi
# ---------- Sample / user AAF files (large, personal — never commit) ----------
sampleaaf/
*.aaf

# Local Krea2 V2 workflow source exports (not for repo)
KREA2V2/

# Generated diagnostic outputs (tools/diag_*.py) — contain project runtime data
/diag.md
/*_diag.md
/chapters.md

# Working audit reports + design blueprints (dev scratch, not for the repo)
/AUDIT_*.md
/BLUEPRINT_*.md

# Stray root npm lockfile (real npm project is in frontend/)
/package-lock.json
diagnostics/

# VNCCS reference repo — analysis only, never commit
/vnccs/
anima/
/vnccs-utils/


# Node-UI screenshots / reference samples — analysis only, never commit
/samples/

# Scratch verification files parked for deletion
/_to_delete*

# One-time self-applying patch scripts (scratch, not for the repo)
/apply_*.py

# Diagnostic scratch: PuLID face probe + third-party node copies (workers only)
/pulid_*.py

# Diagnostic dumps (scripts/dump_state.ps1) - local only
scripts/_diag/
scripts/_agent/

# MiniMax H3 example workflows (Lorenzo's API-ready samples — study copies, not repo)
tempworkflows/

# ============================================================
# v1.276.4 — pre-push audit additions
#
# Measured before the first push in weeks: 683 tracked files under /_diag/
# totalling 327 MB, against ~11 MB of actual application code. The repo was
# 97% diagnostic binaries. `scripts/_diag/` was already ignored; the ROOT
# `_diag/` — the bigger one — never was.
#
# ⚠ .gitignore does NOT untrack anything already committed. Run
# `scripts/git_cleanup.ps1` once to drop these from the index (files stay on
# disk), then commit.
# ============================================================

# ---------- Root diagnostic dumps: GLB/FBX/PNG/tgz, 327 MB ----------
/_diag/
_diag/

# ---------- Third-party reference repos (analysis only, 31 MB) ----------
/VNCCS302/

# ---------- Restore archives / big binaries ----------
*.zip
*.7z
*.rar
*.tar
*.tgz
*.tar.gz
!frontend/**/*.zip

# ---------- 3D / model binaries (regenerate, never review in a diff) ----------
*.glb
*.gltf
*.fbx
*.obj
*.blend
*.blend1
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf

# ---------- Media (generated output, hosted elsewhere) ----------
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.flac

# ---------- Captures ----------
# NOT /Screenshots/ — README.md embeds Screenshots/robomuffin_idea_factory_screenshot.webp
# and the Ko-fi button. Two files, 0.28 MB, and the repo's front page needs them.
/runtime/

# ---------- Built frontend, every variant ----------
frontend/dist*/
node_modules/

# ---------- Windows-path-named strays (a bug once wrote a literal path) ----------
/C:*

# ---------- Internal session handover (dev notes, LAN layout, local paths) ------
# Lorenzo's call 2026-08-09: this is working material, not part of the product.
# It was also the ONLY tracked file containing a C:\Users\hexum path.
/HANDOVER_PROMPT.md
